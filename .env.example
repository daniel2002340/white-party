# Copy this file to .env and fill in real values. Never commit .env.

# --- Database (SQLite via Prisma) ---
# In PRODUCTION always use an ABSOLUTE file: path. Relative paths resolve from
# wherever Prisma finds schema.prisma, which differs between the Prisma CLI and
# the running server, and yields "Error code 14: Unable to open the database file".
#   DATABASE_URL="file:/srv/white-party/data/app.db"
# For local development the relative form below is fine (resolved from prisma/).
DATABASE_URL="file:../data/app.db"

# --- Application ---
# 32+ byte random secret used to sign/encrypt session cookies. Generate with: openssl rand -base64 32
SESSION_SECRET=""
# Public base URL of the site, used for links in emails (no trailing slash). E.g. https://feest.example.nl
APP_URL="http://localhost:3000"
# Port/host the standalone server listens on. Only needed in production (the
# pm2 process reads these). Bind to localhost so only the reverse proxy reaches it.
# PORT="6353"
# HOSTNAME="127.0.0.1"

# --- Email (plain SMTP via nodemailer) ---
# Use 587 (STARTTLS). Most hosting providers block outbound 25 and 465 by
# default — a blocked port shows up as ETIMEDOUT on CONN, never as an auth error.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
# IMPORTANT: escape any literal "$" in the password as "\$". Next expands $VAR
# references when loading .env, so an unescaped $ silently truncates the value
# and the server rejects the login with 535. Single quotes do NOT prevent this.
# A literal backtick must be escaped as \` too, or a shell sourcing this file
# would execute it. Example: SMTP_PASS="ab\$cdefg"
SMTP_PASS=""
# From address for outgoing mail. E.g. "Het Feest <noreply@feest.example.nl>"
SMTP_FROM=""

# --- Photo storage (Cloudflare R2, S3-compatible) ---
# The bucket must be PRIVATE (all access via presigned URLs). See CLAUDE.md for
# the required CORS policy. If these are left empty in development, photos are
# stored on local disk under ./data/r2-dev instead (dev-only fallback).
# R2 S3 API endpoint. E.g. https://<accountid>.r2.cloudflarestorage.com
R2_ENDPOINT=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""

# --- Initial admin (used by the seed script) ---
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""
